# Database Configuration
# For PostgreSQL (Render recommended): postgresql://user:password@host:5432/dbname
# For MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/smart_analytics

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=your-jwt-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
DEBUG=false

# Frontend API
VITE_API_URL=/api

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
USE_LOCAL_LLM=false
OLLAMA_URL=http://localhost:11434

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Storage Configuration
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=INFO

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Database pool settings for production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
